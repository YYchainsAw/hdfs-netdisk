FROM eclipse-temurin:17-jdk-jammy AS build
WORKDIR /src
COPY backend/ /src/backend/
WORKDIR /src/backend
RUN MAVEN_OPTS='-Xmx384m' ./mvnw --batch-mode --no-transfer-progress -DskipTests package
FROM eclipse-temurin:17-jre-jammy
RUN mkdir -p /run/lock /etc/netdisk/secrets && chown 10001:10001 /run/lock
WORKDIR /app
COPY --from=build /src/backend/target/backend-0.0.1-SNAPSHOT.jar /app/backend.jar
USER 10001:10001
ENTRYPOINT ["java", "-Xms64m", "-Xmx256m", "-jar", "/app/backend.jar"]
