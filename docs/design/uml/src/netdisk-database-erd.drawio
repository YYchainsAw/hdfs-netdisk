<mxfile host="app.diagrams.net" version="26.0.0"><diagram id="netdisk-erd" name="数据库关系图"><mxGraphModel dx="1780" dy="1240" grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="网盘系统数据库实体关系图（当前主要表）" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=32;fontStyle=1;fontColor=#16305a;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1780" height="65" as="geometry"/></mxCell><mxCell id="u" value="&lt;b&gt;nd_user  用户&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;username（唯一）&lt;br&gt;password_hash / status" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#edf4ff;strokeColor=#7aa5d9;strokeWidth=2;fontColor=#1e293b;fontFamily=Microsoft YaHei;fontSize=22;" vertex="1" parent="1"><mxGeometry x="675" y="105" width="420" height="170" as="geometry"/></mxCell><mxCell id="node" value="&lt;b&gt;nd_node  文件与目录&lt;/b&gt;&lt;br&gt;PK id　 FK user_id&lt;br&gt;parent_id（0 为虚拟根）&lt;br&gt;name / node_type / status / version&lt;br&gt;storage_key / size_bytes / sha256&lt;br&gt;trash_id / deleted_at / active_name&lt;br&gt;唯一：(user_id,parent_id,active_name)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#edf4ff;strokeColor=#7aa5d9;strokeWidth=2;fontColor=#1e293b;fontFamily=Microsoft YaHei;fontSize=22;" vertex="1" parent="1"><mxGeometry x="675" y="405" width="420" height="270" as="geometry"/></mxCell><mxCell id="old" value="&lt;b&gt;nd_upload  旧版上传任务&lt;/b&gt;&lt;br&gt;PK id　 FK user_id&lt;br&gt;FK node_id → nd_node（可空）&lt;br&gt;request_id / status / expires_at" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#f7f8fb;strokeColor=#a8b3c5;strokeWidth=2;fontColor=#1e293b;fontFamily=Microsoft YaHei;fontSize=22;" vertex="1" parent="1"><mxGeometry x="90" y="115" width="410" height="165" as="geometry"/></mxCell><mxCell id="gc" value="&lt;b&gt;nd_storage_gc  存储清理&lt;/b&gt;&lt;br&gt;PK id　 FK user_id → nd_user&lt;br&gt;storage_key / status&lt;br&gt;retry_count / next_retry_at" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#fff5df;strokeColor=#d1a751;strokeWidth=2;fontColor=#1e293b;fontFamily=Microsoft YaHei;fontSize=22;" vertex="1" parent="1"><mxGeometry x="90" y="425" width="410" height="165" as="geometry"/></mxCell><mxCell id="mp" value="&lt;b&gt;nd_multipart_upload  分片任务&lt;/b&gt;&lt;br&gt;PK id　 FK user_id&lt;br&gt;FK node_id → nd_node（可空）&lt;br&gt;request_id / parent_id / name&lt;br&gt;chunk_size / status / expires_at&lt;br&gt;唯一：(user_id,request_id)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#eaf7ef;strokeColor=#70b68e;strokeWidth=2;fontColor=#1e293b;fontFamily=Microsoft YaHei;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1280" y="105" width="440" height="220" as="geometry"/></mxCell><mxCell id="mf" value="&lt;b&gt;nd_multipart_manifest&lt;/b&gt;&lt;br&gt;PK/FK upload_id&lt;br&gt;PK part_no&lt;br&gt;sha256（预期分片摘要）" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#eaf7ef;strokeColor=#70b68e;strokeWidth=2;fontColor=#1e293b;fontFamily=Microsoft YaHei;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1280" y="415" width="440" height="160" as="geometry"/></mxCell><mxCell id="part" value="&lt;b&gt;nd_multipart_part&lt;/b&gt;&lt;br&gt;PK/FK upload_id → 分片任务&lt;br&gt;PK part_no&lt;br&gt;object_key / sha256 / size_bytes&lt;br&gt;state / token / lease_until" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#eaf7ef;strokeColor=#70b68e;strokeWidth=2;fontColor=#1e293b;fontFamily=Microsoft YaHei;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1280" y="685" width="440" height="190" as="geometry"/></mxCell><mxCell id="share" value="&lt;b&gt;nd_share  分享记录&lt;/b&gt;&lt;br&gt;PK id　 FK owner_id → 用户&lt;br&gt;FK node_id → 文件节点&lt;br&gt;node_version / token_hash / code_hash&lt;br&gt;expires_at / revoked / max_visits / access_count" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#fff5df;strokeColor=#d1a751;strokeWidth=2;fontColor=#1e293b;fontFamily=Microsoft YaHei;fontSize=22;" vertex="1" parent="1"><mxGeometry x="675" y="855" width="420" height="230" as="geometry"/></mxCell><mxCell id="limit" value="&lt;b&gt;nd_multipart_limits&lt;/b&gt;&lt;br&gt;PK id&lt;br&gt;独立限额协调记录，无外键" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#f7f8fb;strokeColor=#a8b3c5;strokeWidth=2;fontColor=#1e293b;fontFamily=Microsoft YaHei;fontSize=22;" vertex="1" parent="1"><mxGeometry x="90" y="825" width="410" height="140" as="geometry"/></mxCell><mxCell id="foot" value="&lt;b&gt;说明&lt;/b&gt;：连线仅示意部分外键，其余外键指向见字段；nd_node.parent_id 表示目录层级，虚拟根目录不使用普通父节点外键。&lt;br&gt;活动文件和文件夹名称共用唯一命名空间；回收节点由 active_name = NULL 排除在该约束外。" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#d5dbe4;strokeWidth=2;fontColor=#1e293b;fontFamily=Microsoft YaHei;fontSize=21;" vertex="1" parent="1"><mxGeometry x="100" y="1110" width="1580" height="100" as="geometry"/></mxCell><mxCell id="e0" value="N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=open;endFill=0;fontSize=17;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" edge="1" source="old" target="u" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=open;endFill=0;fontSize=17;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" edge="1" source="node" target="u" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=open;endFill=0;fontSize=17;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" edge="1" source="mp" target="u" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=open;endFill=0;fontSize=17;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" edge="1" source="mf" target="mp" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=open;endFill=0;fontSize=17;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" edge="1" source="share" target="node" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>