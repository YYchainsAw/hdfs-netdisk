<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="26.0.0"><diagram id="netdisk-erd" name="数据库关系图"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1550" pageHeight="1150" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="数据库实体关系图 · 第一版设计" style="text;html=1;align=center;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="120" y="12" width="1250" height="50" as="geometry" /></mxCell><mxCell id="sub" value="文件内容保存在 HDFS，以下表用于账号、文件元数据和上传状态" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#60758b;" vertex="1" parent="1"><mxGeometry x="120" y="58" width="1250" height="30" as="geometry" /></mxCell><mxCell id="user" value="&lt;div style=&quot;padding:11px 14px;text-align:left;line-height:1.45&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:bold;color:#19395b&quot;&gt;nd_user · 用户&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #bfccda;margin:8px 0&quot;/&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;PK  id&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;username  账号名&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;password_hash  密码哈希&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;status  账号状态&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;created_at / updated_at&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f7faff;strokeColor=#8ea8c3;strokeWidth=1.4;fontSize=14;fontColor=#273d54;spacing=0;" vertex="1" parent="1"><mxGeometry x="85" y="120" width="330" height="235" as="geometry" /></mxCell><mxCell id="node" value="&lt;div style=&quot;padding:11px 14px;text-align:left;line-height:1.45&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:bold;color:#19395b&quot;&gt;nd_node · 文件节点&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #bfccda;margin:8px 0&quot;/&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;PK  id&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;FK  user_id → nd_user.id&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;parent_id  父目录（0 为虚拟根）&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;name  文件或目录名&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;node_type / status  类型、状态&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;storage_key  HDFS 对象标识&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;size_bytes / sha256&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;version  并发版本号&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;created_at / updated_at&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f7faff;strokeColor=#8ea8c3;strokeWidth=1.4;fontSize=14;fontColor=#273d54;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="105" width="410" height="320" as="geometry" /></mxCell><mxCell id="upload" value="&lt;div style=&quot;padding:11px 14px;text-align:left;line-height:1.45&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:bold;color:#19395b&quot;&gt;nd_upload · 上传任务&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #bfccda;margin:8px 0&quot;/&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;PK  id&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;FK  user_id → nd_user.id&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;request_id  幂等请求标识&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;parent_id  目标目录&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;requested_name / target_name&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;temp_key / final_key  存储标识&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;expected_size / sha256&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;status / FK node_id / expires_at&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;created_at / updated_at&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f7faff;strokeColor=#8ea8c3;strokeWidth=1.4;fontSize=14;fontColor=#273d54;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="585" width="410" height="320" as="geometry" /></mxCell><mxCell id="gc" value="&lt;div style=&quot;padding:11px 14px;text-align:left;line-height:1.45&quot;&gt;&lt;div style=&quot;font-size:17px;font-weight:bold;color:#19395b&quot;&gt;nd_storage_gc · 存储清理任务&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #bfccda;margin:8px 0&quot;/&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;PK  id&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;FK  user_id → nd_user.id&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;storage_key  待清理对象&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;reason / status&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;retry_count / next_retry_at&lt;/div&gt;&lt;div style=&quot;padding:2px 0&quot;&gt;created_at / updated_at&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f7faff;strokeColor=#8ea8c3;strokeWidth=1.4;fontSize=14;fontColor=#273d54;spacing=0;" vertex="1" parent="1"><mxGeometry x="85" y="625" width="330" height="260" as="geometry" /></mxCell><mxCell id="un" value="1 : 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#718096;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="node"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ug" value="1 : 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#718096;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="gc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="uu" value="1 : 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#718096;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="user" target="upload"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="320" /><mxPoint x="610" y="745" /></Array></mxGeometry></mxCell><mxCell id="nu" value="0..1 : 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#718096;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="node" target="upload"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="连线表示数据库外键关系。parent_id 是逻辑关联，0 表示虚拟根目录。&lt;br&gt;跨 HDFS 与数据库的异常恢复需要任务状态和清理机制。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#fffdf6;strokeColor=#d5c8a0;fontSize=14;fontColor=#5b5141;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="450" y="975" width="760" height="78" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>