<mxfile host="app.diagrams.net" version="26.0.0"><diagram id="netdisk-class" name="类图"><mxGraphModel dx="1650" dy="1300" grid="1" gridSize="10" guides="1" connect="1" page="1" pageWidth="1550" pageHeight="1260" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="网盘系统类图 · 第一版设计" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#18324e;" vertex="1" parent="1"><mxGeometry x="100" y="15" width="1360" height="48" as="geometry"/></mxCell><mxCell id="subtitle" value="概念设计 · Java 属性使用驼峰命名，对应数据库的下划线字段" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#5b6d7e;" vertex="1" parent="1"><mxGeometry x="100" y="65" width="1360" height="28" as="geometry"/></mxCell><mxCell id="entitieslabel" value="数据模型" style="text;html=1;align=left;fontSize=17;fontStyle=1;fontColor=#436280;" vertex="1" parent="1"><mxGeometry x="45" y="104" width="180" height="30" as="geometry"/></mxCell><mxCell id="user" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:16px;&quot;&gt;«实体» NdUser&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #52769d;margin:7px 0 8px 0;&quot;&gt;&lt;div style=&quot;font-size:14px;line-height:1.5;text-align:left;&quot;&gt;- id: Long&lt;br&gt;- username: String&lt;br&gt;- passwordHash: String&lt;br&gt;- status: UserStatus&lt;br&gt;- createdAt: Instant&lt;br&gt;- updatedAt: Instant&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf2fc;strokeColor=#52769d;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontColor=#172c45;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="55" y="155" width="260" height="370" as="geometry"/></mxCell><mxCell id="node" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:16px;&quot;&gt;«实体» NdNode&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #52769d;margin:7px 0 8px 0;&quot;&gt;&lt;div style=&quot;font-size:14px;line-height:1.5;text-align:left;&quot;&gt;- id: Long&lt;br&gt;- userId: Long&lt;br&gt;- parentId: Long&lt;br&gt;- name: String&lt;br&gt;- nodeType: NodeType&lt;br&gt;- status: NodeStatus&lt;br&gt;- storageKey: String?&lt;br&gt;- sizeBytes: Long?&lt;br&gt;- sha256: String?&lt;br&gt;- version: Long&lt;br&gt;- createdAt / updatedAt: Instant&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf2fc;strokeColor=#52769d;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontColor=#172c45;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="395" y="155" width="280" height="370" as="geometry"/></mxCell><mxCell id="upload" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:16px;&quot;&gt;«实体» NdUpload&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #52769d;margin:7px 0 8px 0;&quot;&gt;&lt;div style=&quot;font-size:14px;line-height:1.5;text-align:left;&quot;&gt;- id / userId: Long&lt;br&gt;- requestId: String&lt;br&gt;- parentId: Long&lt;br&gt;- requestedName: String&lt;br&gt;- targetName: String?&lt;br&gt;- tempKey / finalKey: String&lt;br&gt;- expectedSize: Long&lt;br&gt;- sha256: String?&lt;br&gt;- status: UploadStatus&lt;br&gt;- nodeId: Long?&lt;br&gt;- expiresAt: Instant&lt;br&gt;- createdAt / updatedAt: Instant&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf2fc;strokeColor=#52769d;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontColor=#172c45;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="775" y="155" width="320" height="370" as="geometry"/></mxCell><mxCell id="gc" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:16px;&quot;&gt;«实体» NdStorageGc&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #52769d;margin:7px 0 8px 0;&quot;&gt;&lt;div style=&quot;font-size:14px;line-height:1.5;text-align:left;&quot;&gt;- id / userId: Long&lt;br&gt;- storageKey: String&lt;br&gt;- reason: String&lt;br&gt;- status: GcStatus&lt;br&gt;- retryCount: Integer&lt;br&gt;- nextRetryAt: Instant&lt;br&gt;- createdAt / updatedAt: Instant&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf2fc;strokeColor=#52769d;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontColor=#172c45;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1180" y="155" width="300" height="370" as="geometry"/></mxCell><mxCell id="usernode" value="1    拥有    0..*" style="endArrow=none;startArrow=none;html=1;strokeColor=#52677d;strokeWidth=1.4;fontSize=13;fontColor=#40536b;" edge="1" source="user" target="node" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nodeupload" value="0..1    结果文件    0..*" style="endArrow=none;startArrow=none;html=1;strokeColor=#52677d;strokeWidth=1.4;fontSize=13;fontColor=#40536b;" edge="1" source="node" target="upload" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="目录层级由 parentId 表示，0 为虚拟根目录；同一用户、同一目录内名称唯一。" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#586b7d;" vertex="1" parent="1"><mxGeometry x="350" y="540" width="800" height="38" as="geometry"/></mxCell><mxCell id="serviceslabel" value="业务与存储职责" style="text;html=1;align=left;fontSize=17;fontStyle=1;fontColor=#457361;" vertex="1" parent="1"><mxGeometry x="45" y="593" width="210" height="30" as="geometry"/></mxCell><mxCell id="usersvc" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:16px;&quot;&gt;«服务» UserService&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #5c8d74;margin:7px 0 8px 0;&quot;&gt;&lt;div style=&quot;font-size:14px;line-height:1.5;text-align:left;&quot;&gt;+ login(username, password)&lt;br&gt;+ authenticate(session)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf8f3;strokeColor=#5c8d74;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontColor=#172c45;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="55" y="650" width="260" height="190" as="geometry"/></mxCell><mxCell id="filesvc" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:16px;&quot;&gt;«服务» FileService&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #5c8d74;margin:7px 0 8px 0;&quot;&gt;&lt;div style=&quot;font-size:14px;line-height:1.5;text-align:left;&quot;&gt;+ list(parentId)&lt;br&gt;+ search(parentId, query)&lt;br&gt;+ createFolder(name)&lt;br&gt;+ rename(nodeId, version)&lt;br&gt;+ move(nodeId, version)&lt;br&gt;+ delete(nodeId, version)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf8f3;strokeColor=#5c8d74;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontColor=#172c45;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="395" y="650" width="280" height="220" as="geometry"/></mxCell><mxCell id="uploadsvc" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:16px;&quot;&gt;«服务» UploadService&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #5c8d74;margin:7px 0 8px 0;&quot;&gt;&lt;div style=&quot;font-size:14px;line-height:1.5;text-align:left;&quot;&gt;+ initiate(requestId, file)&lt;br&gt;+ complete(uploadId, strategy)&lt;br&gt;+ cancel(uploadId)&lt;br&gt;+ resolveNameConflict()&lt;br&gt;+ checkVersion()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf8f3;strokeColor=#5c8d74;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontColor=#172c45;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="775" y="650" width="320" height="220" as="geometry"/></mxCell><mxCell id="gcsvc" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:16px;&quot;&gt;«服务» StorageGcService&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #5c8d74;margin:7px 0 8px 0;&quot;&gt;&lt;div style=&quot;font-size:14px;line-height:1.5;text-align:left;&quot;&gt;+ reconcile()&lt;br&gt;+ cleanExpiredUploads()&lt;br&gt;+ retryPendingCleanup()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf8f3;strokeColor=#5c8d74;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontColor=#172c45;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1180" y="650" width="300" height="190" as="geometry"/></mxCell><mxCell id="storage" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:16px;&quot;&gt;«接口» StorageClient&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #ad853e;margin:7px 0 8px 0;&quot;&gt;&lt;div style=&quot;font-size:14px;line-height:1.5;text-align:left;&quot;&gt;+ writeTemp(key, stream)&lt;br&gt;+ publish(tempKey, finalKey)&lt;br&gt;+ read(key)&lt;br&gt;+ delete(key)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#ad853e;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontColor=#172c45;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="780" y="960" width="310" height="185" as="geometry"/></mxCell><mxCell id="ud" value="管理" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#5d8873;strokeWidth=1.4;fontSize=13;fontColor=#4d6d5a;" edge="1" source="usersvc" target="user" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fd" value="管理" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#5d8873;strokeWidth=1.4;fontSize=13;fontColor=#4d6d5a;" edge="1" source="filesvc" target="node" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="up" value="管理" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#5d8873;strokeWidth=1.4;fontSize=13;fontColor=#4d6d5a;" edge="1" source="uploadsvc" target="upload" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="gd" value="处理" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#5d8873;strokeWidth=1.4;fontSize=13;fontColor=#4d6d5a;" edge="1" source="gcsvc" target="gc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="us" value="使用" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#5d8873;strokeWidth=1.4;fontSize=13;fontColor=#4d6d5a;" edge="1" source="uploadsvc" target="storage" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="gs" value="使用" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#5d8873;strokeWidth=1.4;fontSize=13;fontColor=#4d6d5a;" edge="1" source="gcsvc" target="storage" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="constraint" value="约束：登录后访问；同名上传可保留两份或跳过；并发变更需校验版本。HDFS 与数据库的跨系统失败通过状态和补偿处理。" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#526678;" vertex="1" parent="1"><mxGeometry x="100" y="1190" width="1380" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>