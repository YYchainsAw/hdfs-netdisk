<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="26.0.0"><diagram id="upload-conflict-flow" name="上传冲突流程图"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1450" pageHeight="1150" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="分片上传与同名冲突处理流程" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=26;fontStyle=1;fontColor=#17314e;" vertex="1" parent="1"><mxGeometry x="300" y="15" width="850" height="45" as="geometry"/></mxCell><mxCell id="start" value="选择文件并发起上传" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e6f5ed;strokeColor=#4a9870;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="45" y="105" width="300" height="60" as="geometry"/></mxCell><mxCell id="hash" value="按 8 MiB 分片并计算&lt;br&gt;各片 SHA-256 摘要" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#edf5fd;strokeColor=#4876aa;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="45" y="200" width="300" height="80" as="geometry"/></mxCell><mxCell id="create" value="提交 requestId、文件信息&lt;br&gt;及摘要清单，创建任务" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#edf5fd;strokeColor=#4876aa;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="45" y="325" width="300" height="80" as="geometry"/></mxCell><mxCell id="status" value="查询状态；上传缺失分片&lt;br&gt;校验分片长度和摘要" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#edf5fd;strokeColor=#4876aa;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="45" y="450" width="300" height="80" as="geometry"/></mxCell><mxCell id="ready" value="全部分片&lt;br&gt;就绪？" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=19;fillColor=#fff8e6;strokeColor=#b5893c;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="115" y="570" width="160" height="100" as="geometry"/></mxCell><mxCell id="lock" value="锁定并校验目标目录" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#edf5fd;strokeColor=#4876aa;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="590" width="280" height="70" as="geometry"/></mxCell><mxCell id="conflict" value="存在同名？" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=19;fillColor=#fff8e6;strokeColor=#b5893c;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="755" y="575" width="150" height="100" as="geometry"/></mxCell><mxCell id="reserve" value="预留目标名称和文件节点" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#edf5fd;strokeColor=#4876aa;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1060" y="565" width="300" height="85" as="geometry"/></mxCell><mxCell id="strategy" value="冲突处理策略" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=19;fillColor=#fff8e6;strokeColor=#b5893c;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="755" y="740" width="150" height="100" as="geometry"/></mxCell><mxCell id="fail" value="FAIL：返回冲突&lt;br&gt;由用户决定后续操作" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fillColor=#fff1ee;strokeColor=#c76555;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="730" width="260" height="80" as="geometry"/></mxCell><mxCell id="skip" value="SKIP：跳过上传" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fillColor=#fff1ee;strokeColor=#c76555;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="465" y="880" width="225" height="65" as="geometry"/></mxCell><mxCell id="keep" value="KEEP_BOTH：生成可用名称" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#edf5fd;strokeColor=#4876aa;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="910" width="280" height="75" as="geometry"/></mxCell><mxCell id="merge" value="流式合并分片到&lt;br&gt;唯一 HDFS 文件对象" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#edf5fd;strokeColor=#4876aa;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1060" y="695" width="300" height="90" as="geometry"/></mxCell><mxCell id="done" value="节点 READY&lt;br&gt;任务 COMPLETED" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e6f5ed;strokeColor=#4a9870;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1060" y="850" width="300" height="80" as="geometry"/></mxCell><mxCell id="note" value="中断或超时：查询状态并幂等重试；失败时按任务状态处理和清理。&lt;br&gt;分片传完不等于发布成功；禁止静默覆盖同名文件。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#53687e;align=center;" vertex="1" parent="1"><mxGeometry x="110" y="1035" width="1230" height="65" as="geometry"/></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b617a;fontColor=#30465d;fontSize=15;" edge="1" parent="1" source="start" target="hash"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b617a;fontColor=#30465d;fontSize=15;" edge="1" parent="1" source="hash" target="create"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b617a;fontColor=#30465d;fontSize=15;" edge="1" parent="1" source="create" target="status"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b617a;fontColor=#30465d;fontSize=15;" edge="1" parent="1" source="status" target="ready"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b617a;fontColor=#30465d;fontSize=15;" edge="1" parent="1" source="ready" target="lock"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f6" value="否：补传" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b617a;fontColor=#30465d;fontSize=15;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ready" target="status"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="10" y="620"/><mxPoint x="10" y="490"/></Array></mxGeometry></mxCell><mxCell id="f7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b617a;fontColor=#30465d;fontSize=15;" edge="1" parent="1" source="lock" target="conflict"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f8" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b617a;fontColor=#30465d;fontSize=15;" edge="1" parent="1" source="conflict" target="reserve"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f9" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b617a;fontColor=#30465d;fontSize=15;" edge="1" parent="1" source="conflict" target="strategy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f10" value="FAIL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b617a;fontColor=#30465d;fontSize=15;" edge="1" parent="1" source="strategy" target="fail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f11" value="SKIP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b617a;fontColor=#30465d;fontSize=15;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="strategy" target="skip"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="865"/><mxPoint x="577" y="865"/></Array></mxGeometry></mxCell><mxCell id="f12" value="KEEP_BOTH" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b617a;fontColor=#30465d;fontSize=15;" edge="1" parent="1" source="strategy" target="keep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b617a;fontColor=#30465d;fontSize=15;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="keep" target="reserve"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1390" y="947"/><mxPoint x="1390" y="608"/></Array></mxGeometry></mxCell><mxCell id="f14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b617a;fontColor=#30465d;fontSize=15;" edge="1" parent="1" source="reserve" target="merge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b617a;fontColor=#30465d;fontSize=15;" edge="1" parent="1" source="merge" target="done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>